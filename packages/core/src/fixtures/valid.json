{
  "id": "workflow_1",
  "name": "HTTP to Slack Summary",
  "version": 1,
  "nodes": [
    {
      "id": "manual_1",
      "type": "manual.trigger",
      "typeVersion": 1,
      "params": {},
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "http_1",
      "type": "http.request",
      "typeVersion": 1,
      "params": {
        "url": {
          "kind": "literal",
          "value": "https://example.com"
        },
        "method": {
          "kind": "literal",
          "value": "GET"
        }
      },
      "position": {
        "x": 250,
        "y": 0
      }
    },
    {
      "id": "llm_1",
      "type": "llm.prompt",
      "typeVersion": 1,
      "params": {
        "model": {
          "kind": "literal",
          "value": "gemini"
        },
        "prompt": {
          "kind": "template",
          "template": "Summarize the HTTP response status: {{http_1.status}}"
        }
      },
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "slack_1",
      "type": "slack.post",
      "typeVersion": 1,
      "params": {
        "channel": {
          "kind": "placeholder",
          "placeholder": {
            "type": "slack_channel",
            "prompt": "Enter the Slack channel",
            "reason": "not_specified"
          }
        },
        "message": {
          "kind": "template",
          "template": "{{llm_1.text}}"
        }
      },
      "position": {
        "x": 750,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "from": "manual_1",
      "fromPort": "main",
      "to": "http_1"
    },
    {
      "id": "edge_2",
      "from": "http_1",
      "fromPort": "main",
      "to": "llm_1"
    },
    {
      "id": "edge_3",
      "from": "llm_1",
      "fromPort": "main",
      "to": "slack_1"
    }
  ]
}